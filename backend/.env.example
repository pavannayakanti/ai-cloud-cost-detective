OPENAI_API_KEY=

# AWS RDS / Aurora PostgreSQL-Compatible connection string.
# Format: postgresql://<user>:<password>@<host>:5432/<database>
# If RDS is provisioned inside a VPC (the common case), make sure the DB
# instance's security group allows inbound access on port 5432 from wherever
# this backend runs (your local IP for dev, or the ECS/EC2/Lambda security
# group in prod) — otherwise the connection will hang until it times out.
# As an alternative to a static password, you can use IAM database auth:
# generate a short-lived token with `aws rds generate-db-auth-token` and pass
# it as the password instead of storing one here.
DATABASE_URL=postgresql://user:password@your-db-instance.rds.amazonaws.com:5432/cost_detective

# Secret used to sign/verify JWTs issued by the auth endpoints.
JWT_SECRET=
